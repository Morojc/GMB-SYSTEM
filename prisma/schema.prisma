generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model bon_commande {
  id_bon        Int       @id @default(autoincrement())
  id_commande   Int?
  date_creation DateTime? @db.Date
  commande      commande? @relation(fields: [id_commande], references: [id_commande], onDelete: NoAction, onUpdate: NoAction)
}

model bon_livraison {
  id_bon        Int        @id @default(autoincrement())
  id_livraison  Int?
  date_creation DateTime?  @db.Date
  livraison     livraison? @relation(fields: [id_livraison], references: [id_livraison], onDelete: NoAction, onUpdate: NoAction)
}

model catalogue {
  id_catalogue      Int                 @id @default(autoincrement())
  nom               String?             @db.VarChar(100)
  catalogue_produit catalogue_produit[]
}

model catalogue_produit {
  id_catalogue Int
  id_produit   Int
  catalogue    catalogue @relation(fields: [id_catalogue], references: [id_catalogue], onDelete: NoAction, onUpdate: NoAction)
  produit      produit   @relation(fields: [id_produit], references: [id_produit], onDelete: NoAction, onUpdate: NoAction)

  @@id([id_catalogue, id_produit])
}

model client {
  id_client   Int        @id @default(autoincrement())
  id_personne Int?       @unique
  personne    personne?  @relation(fields: [id_personne], references: [id_personne], onDelete: Cascade, onUpdate: NoAction)
  commande    commande[]
}

model commande {
  id_commande    Int              @id @default(autoincrement())
  date_commande  DateTime?        @db.Date
  statut         String?          @db.VarChar(50)
  id_client      Int?
  bon_commande   bon_commande[]
  client         client?          @relation(fields: [id_client], references: [id_client], onDelete: NoAction, onUpdate: NoAction)
  facture        facture[]
  ligne_commande ligne_commande[]
}

model employe {
  id_employe    Int           @id @default(autoincrement())
  id_personne   Int?          @unique
  id_role       Int?
  date_embauche DateTime?     @db.Date
  personne      personne?     @relation(fields: [id_personne], references: [id_personne], onDelete: NoAction, onUpdate: NoAction)
  role_employe  role_employe? @relation(fields: [id_role], references: [id_role], onDelete: NoAction, onUpdate: NoAction)
  salaire       salaire[]
}

model facture {
  id_facture   Int         @id @default(autoincrement())
  date_facture DateTime?   @db.Date
  montant      Decimal?    @db.Decimal(10, 2)
  id_commande  Int?
  commande     commande?   @relation(fields: [id_commande], references: [id_commande], onDelete: NoAction, onUpdate: NoAction)
  livraison    livraison[]
}

model ligne_commande {
  id_ligne      Int       @id @default(autoincrement())
  id_commande   Int?
  id_produit    Int?
  quantite      Int?
  prix_unitaire Decimal?  @db.Decimal(10, 2)
  commande      commande? @relation(fields: [id_commande], references: [id_commande], onDelete: NoAction, onUpdate: NoAction)
  produit       produit?  @relation(fields: [id_produit], references: [id_produit], onDelete: NoAction, onUpdate: NoAction)
}

model livraison {
  id_livraison   Int             @id @default(autoincrement())
  date_livraison DateTime?       @db.Date
  statut         String?         @db.VarChar(50)
  id_facture     Int?
  id_livreur     Int?
  bon_livraison  bon_livraison[]
  facture        facture?        @relation(fields: [id_facture], references: [id_facture], onDelete: NoAction, onUpdate: NoAction)
  livreur        livreur?        @relation(fields: [id_livreur], references: [id_livreur], onDelete: NoAction, onUpdate: NoAction)
}

model livreur {
  id_livreur Int         @id @default(autoincrement())
  nom        String?     @db.VarChar(100)
  telephone  String?     @db.VarChar(20)
  livraison  livraison[]
}

model matiere_premiere {
  id_matiere          Int                   @id @default(autoincrement())
  nom                 String?               @db.VarChar(100)
  quantite            Int?
  id_silon            Int?
  silon               silon?                @relation(fields: [id_silon], references: [id_silon], onDelete: NoAction, onUpdate: NoAction)
  ligne_achat         ligne_achat[]
  fabrication_intrant fabrication_intrant[]
}

model personne {
  id_personne Int      @id @default(autoincrement())
  nom         String   @db.VarChar(100)
  prenom      String   @db.VarChar(100)
  telephone   String?  @db.VarChar(20)
  email       String?  @unique @db.VarChar(150)
  adresse     String?
  password    String?  
  client      client?
  employe     employe?
}

model produit {
  id_produit        Int                 @id @default(autoincrement())
  nom               String?             @db.VarChar(150)
  prix              Decimal?            @db.Decimal(10, 2)
  quantite_stock    Int?
  id_type           Int?
  catalogue_produit   catalogue_produit[]
  ligne_commande      ligne_commande[]
  type_produit        type_produit?         @relation(fields: [id_type], references: [id_type], onDelete: NoAction, onUpdate: NoAction)
  stock               stock[]
  fabrication_produit fabrication_produit[]
}

model role_employe {
  id_role  Int       @id @default(autoincrement())
  nom_role String    @db.VarChar(100)
  tache    String?
  employe  employe[]
}

model salaire {
  id_salaire        Int       @id @default(autoincrement())
  id_employe        Int?
  montant           Decimal?  @db.Decimal(10, 2)
  date_modification DateTime? @db.Date
  employe           employe?  @relation(fields: [id_employe], references: [id_employe], onDelete: NoAction, onUpdate: NoAction)
}

model silon {
  id_silon         Int                @id @default(autoincrement())
  nom              String?            @db.VarChar(100)
  capacite         Int?
  matiere_premiere matiere_premiere[]
}

model stock {
  id_stock   Int         @id @default(autoincrement())
  id_produit Int?
  id_zone    Int?
  quantite   Int?
  produit    produit?    @relation(fields: [id_produit], references: [id_produit], onDelete: NoAction, onUpdate: NoAction)
  zone_stock zone_stock? @relation(fields: [id_zone], references: [id_zone], onDelete: NoAction, onUpdate: NoAction)
}

model type_produit {
  id_type  Int       @id @default(autoincrement())
  nom_type String?   @db.VarChar(100)
  produit  produit[]
}

model zone_stock {
  id_zone  Int     @id @default(autoincrement())
  nom      String? @db.VarChar(100)
  capacite Int?
  stock    stock[]
}

// ─── Approvisionnement (procurement: buying wheat / raw material) ───────────

model fournisseur {
  id_fournisseur Int      @id @default(autoincrement())
  nom            String   @db.VarChar(150)
  telephone      String?  @db.VarChar(20)
  email          String?  @db.VarChar(150)
  adresse        String?
  achat          achat[]
}

model achat {
  id_achat       Int             @id @default(autoincrement())
  id_fournisseur Int?
  date_achat     DateTime?       @db.Date
  statut         String?         @db.VarChar(50) // Commandé | Reçu | Annulé
  fournisseur    fournisseur?    @relation(fields: [id_fournisseur], references: [id_fournisseur], onDelete: NoAction, onUpdate: NoAction)
  ligne_achat    ligne_achat[]
  facture_achat  facture_achat[]
}

model ligne_achat {
  id_ligne_achat   Int               @id @default(autoincrement())
  id_achat         Int?
  id_matiere       Int?
  quantite         Int?
  prix_unitaire    Decimal?          @db.Decimal(10, 2)
  achat            achat?            @relation(fields: [id_achat], references: [id_achat], onDelete: NoAction, onUpdate: NoAction)
  matiere_premiere matiere_premiere? @relation(fields: [id_matiere], references: [id_matiere], onDelete: NoAction, onUpdate: NoAction)
}

model facture_achat {
  id_facture_achat Int       @id @default(autoincrement())
  id_achat         Int?
  date_facture     DateTime? @db.Date
  montant          Decimal?  @db.Decimal(10, 2)
  achat            achat?    @relation(fields: [id_achat], references: [id_achat], onDelete: NoAction, onUpdate: NoAction)
}

// ─── Production (milling wheat into finished products) ──────────────────────

model fabrication {
  id_fabrication      Int                   @id @default(autoincrement())
  date_fabrication    DateTime?             @db.Date
  statut              String?               @db.VarChar(50) // En cours | Terminée | Annulée
  note                String?
  fabrication_intrant fabrication_intrant[]
  fabrication_produit fabrication_produit[]
}

model fabrication_intrant {
  id_intrant       Int               @id @default(autoincrement())
  id_fabrication   Int?
  id_matiere       Int?
  quantite         Int?
  fabrication      fabrication?      @relation(fields: [id_fabrication], references: [id_fabrication], onDelete: NoAction, onUpdate: NoAction)
  matiere_premiere matiere_premiere? @relation(fields: [id_matiere], references: [id_matiere], onDelete: NoAction, onUpdate: NoAction)
}

model fabrication_produit {
  id_fab_produit Int          @id @default(autoincrement())
  id_fabrication Int?
  id_produit     Int?
  quantite       Int?
  fabrication    fabrication? @relation(fields: [id_fabrication], references: [id_fabrication], onDelete: NoAction, onUpdate: NoAction)
  produit        produit?     @relation(fields: [id_produit], references: [id_produit], onDelete: NoAction, onUpdate: NoAction)
}
